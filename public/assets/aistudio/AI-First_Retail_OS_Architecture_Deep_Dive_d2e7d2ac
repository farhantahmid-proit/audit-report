// src/inventory/inventory.service.ts


async transferStock(dto: TransferStockDto) {
  return await this.prisma.$transaction(async (tx) => {
    // 1. Decrement stock from Source
    const sourceStock = await tx.stock.update({
      where: {
        productId_branchId: {
          productId: dto.productId,
          branchId: dto.fromBranchId,
        },
      },
      data: {
        quantity: { decrement: dto.quantity },
      },
    });


    // 2. Safety Check: Prevent negative stock unless allowed by settings
    if (sourceStock.quantity < 0) {
      throw new BadRequestException("Insufficient stock in source branch.");
    }


    // 3. Increment stock at Destination (Upsert used in case record doesn't exist)
    await tx.stock.upsert({
      where: {
        productId_branchId: {
          productId: dto.productId,
          branchId: dto.toBranchId,
        },
      },
      update: {
        quantity: { increment: dto.quantity },
      },
      create: {
        productId: dto.productId,
        branchId: dto.toBranchId,
        quantity: dto.quantity,
      },
    });


    // 4. Create Audit Log / Transfer Record
    return await tx.transfer.create({
      data: {
        fromBranchId: dto.fromBranchId,
        toBranchId: dto.toBranchId,
        productId: dto.productId,
        quantity: dto.quantity,
      },
    });
  });
}



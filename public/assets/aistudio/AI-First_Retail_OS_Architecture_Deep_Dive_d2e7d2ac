```ts
// packages/ai-orchestrator/memory/VectorMemory.ts
import { QdrantClient } from '@qdrant/js-client-rest';
import { embedText } from '../embeddings'; // Gemini Nano or local embedding


export interface MemoryEntry {
  id: string;
  tenantId: string;
  action: string;
  input: string;
  result: any;
  timestamp: number;
  embedding?: number[];
}


export class VectorMemory {
  private client: QdrantClient;
  private collectionName = "hellokhata_memory";


  constructor() {
    this.client = new QdrantClient({ url: process.env.QDRANT_URL || "http://localhost:6333" });
    this.initCollection();
  }


  private async initCollection() {
    try {
      await this.client.getCollection(this.collectionName);
    } catch {
      await this.client.createCollection(this.collectionName, {
        vectors: {
          size: 768, // or 1024/3072 depending on embedding model
          distance: "Cosine",
        },
      });
    }
  }


  async store(entry: Omit<MemoryEntry, 'id' | 'embedding'>): Promise<void> {
    const embedding = await embedText(entry.input + " " + JSON.stringify(entry.result));


    const point = {
      id: Date.now().toString(),
      vector: embedding,
      payload: {
        tenantId: entry.tenantId,
        action: entry.action,
        input: entry.input,
        result: entry.result,
        timestamp: entry.timestamp || Date.now(),
      },
    };


    await this.client.upsert(this.collectionName, { points: [point] });
  }


  async getRecent(tenantId: string, limit = 10): Promise<MemoryEntry[]> {
    const results = await this.client.search(this.collectionName, {
      vector: await embedText("recent context for " + tenantId),
      limit,
      filter: { must: [{ key: "tenantId", match: { value: tenantId } }] },
    });


    return results.map(r => ({
      id: r.id as string,
      tenantId: r.payload?.tenantId as string,
      action: r.payload?.action as string,
      input: r.payload?.input as string,
      result: r.payload?.result,
      timestamp: r.payload?.timestamp as number,
    }));
  }


  async clearTenant(tenantId: string): Promise<void> {
    await this.client.delete(this.collectionName, {
      filter: { must: [{ key: "tenantId", match: { value: tenantId } }] },
    });
  }
}
```



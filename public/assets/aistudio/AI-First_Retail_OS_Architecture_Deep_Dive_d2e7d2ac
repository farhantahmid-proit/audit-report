// orchestrator/MultiAgentOrchestrator.ts
export class MultiAgentOrchestrator {
  private agents = new Map<string, BaseAgent>();
  private memory = new VectorMemory(); // Qdrant or local


  constructor() {
    this.registerAgents();
  }


  private registerAgents() {
    this.agents.set("Planner", new PlannerAgent());
    this.agents.set("InventoryUpdater", new InventoryExecutor());
    this.agents.set("Validator", new ValidatorAgent());
    this.agents.set("KycProcessor", new KycAgent());
  }


  async run(userInput: string, context: AgentContext): Promise<any> {
    // Step 1: Planning
    const planner = this.agents.get("Planner")!;
    const plan = await planner.execute(userInput, context);


    const results = [];


    // Step 2: Execute DAG
    for (const step of plan.data.steps) {
      const agent = this.agents.get(step.agent);
      if (!agent) continue;


      const result = await agent.execute(step, context);
      results.push(result);


      // Early exit on critical failure
      if (!result.success && result.confidence < 0.7) {
        return { success: false, stage: step.agent, error: result.error };
      }
    }


    // Step 3: Final Validation
    const validator = this.agents.get("Validator")!;
    const finalCheck = await validator.execute(results, context);


    return {
      success: finalCheck.success,
      results,
      finalValidation: finalCheck
    };
  }
}

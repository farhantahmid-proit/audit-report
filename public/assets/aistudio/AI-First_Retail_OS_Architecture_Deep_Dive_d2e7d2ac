                buffer.put(((pixel shr 16) and 0xFF) / 255f)  // R
                buffer.put(((pixel shr 8) and 0xFF) / 255f)   // G
                buffer.put((pixel and 0xFF) / 255f)           // B
            }
        }
        buffer.rewind()
        
        return OnnxTensor.createTensor(env, buffer, longArrayOf(1, 3, 640, 640))

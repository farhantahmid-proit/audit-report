class FaceVerificationManager(private val context: Context) {
    private val faceDetector: FaceDetector


    init {
        val options = FaceDetectorOptions.Builder()
            .setPerformanceMode(FaceDetectorOptions.PERFORMANCE_MODE_FAST)
            .setLandmarkMode(FaceDetectorOptions.LANDMARK_MODE_ALL)
            .setClassificationMode(FaceDetectorOptions.CLASSIFICATION_MODE_ALL)
            .build()
        faceDetector = FaceDetection.getClient(options)
    }


    suspend fun verifyFace(selfieUri: Uri, nidFaceUri: Uri): FaceMatchResult {
        val selfieBitmap = loadBitmap(selfieUri)
        val nidBitmap = loadBitmap(nidFaceUri)


        val selfieTask = faceDetector.process(selfieBitmap)
        val nidTask = faceDetector.process(nidBitmap)


        val selfieFaces = Tasks.await(selfieTask)
        val nidFaces = Tasks.await(nidTask)


        if (selfieFaces.isEmpty() || nidFaces.isEmpty()) return FaceMatchResult(false, 0f)


        // Simple embedding comparison (or use ML Kit Face Embeddings)
        val similarity = calculateFaceSimilarity(selfieFaces[0], nidFaces[0])
        return FaceMatchResult(similarity > 0.75f, similarity)
    }
}

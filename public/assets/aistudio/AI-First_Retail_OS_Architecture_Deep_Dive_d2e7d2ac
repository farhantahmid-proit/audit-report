### **2. Full YOLO NMS Post-Processing Implementation**


```kotlin
// Detection.kt
data class Detection(
    val bbox: RectF,           // x, y, width, height
    val confidence: Float,
    val classId: Int,
    val className: String
)


// In OnnxInferenceManager.kt or VisionScannerManager.kt
private fun postProcessYOLO(outputs: OrtSession.Result, confThreshold: Float = 0.45f, iouThreshold: Float = 0.5f): List<Detection> {
    val detections = mutableListOf<Detection>()


    // YOLOv8 output parsing (adjust according to your model output shape)
    val outputTensor = outputs[0].value as Array<*>  // Usually [1, 84, 8400] or similar


    for (i in 0 until outputTensor.size) {
        val pred = outputTensor[i] as FloatArray


        val confidence = pred[4]  // Objectness score
        if (confidence < confThreshold) continue


        // Find class with max probability
        var maxClassProb = 0f
        var classId = 0
        for (c in 0 until numClasses) {
            if (pred[5 + c] > maxClassProb) {
                maxClassProb = pred[5 + c]
                classId = c
            }
        }


        val finalScore = confidence * maxClassProb
        if (finalScore < confThreshold) continue


        // Extract box
        val x = pred[0]
        val y = pred[1]
        val w = pred[2]
        val h = pred[3]


        detections.add(Detection(
            bbox = RectF(x - w/2, y - h/2, x + w/2, y + h/2),
            confidence = finalScore,
            classId = classId,
            className = getClassName(classId)
        ))
    }


    // Non-Maximum Suppression (NMS)
    return applyNMS(detections, iouThreshold)
}


private fun applyNMS(detections: List<Detection>, iouThreshold: Float): List<Detection> {
    val sorted = detections.sortedByDescending { it.confidence }.toMutableList()
    val result = mutableListOf<Detection>()


    while (sorted.isNotEmpty()) {
        val best = sorted.removeAt(0)
        result.add(best)


        sorted.removeAll { det ->
            calculateIoU(best.bbox, det.bbox) > iouThreshold
        }
    }
    return result
}


private fun calculateIoU(boxA: RectF, boxB: RectF): Float {
    val interLeft = maxOf(boxA.left, boxB.left)
    val interTop = maxOf(boxA.top, boxB.top)
    val interRight = minOf(boxA.right, boxB.right)
    val interBottom = minOf(boxA.bottom, boxB.bottom)


    if (interLeft >= interRight || interTop >= interBottom) return 0f


    val interArea = (interRight - interLeft) * (interBottom - interTop)
    val areaA = boxA.width() * boxA.height()
    val areaB = boxB.width() * boxB.height()


    return interArea / (areaA + areaB - interArea)
}

### **1. Complete `MultiAgentOrchestrator.ts`**


**File**: `packages/ai-orchestrator/MultiAgentOrchestrator.ts`


```ts
// packages/ai-orchestrator/MultiAgentOrchestrator.ts
import { BaseAgent, AgentContext, AgentOutput } from './Agent';
import { PlannerAgent } from './agents/PlannerAgent';
import { InventoryExecutor } from './agents/InventoryExecutor';
import { VoiceProcessor } from './agents/VoiceProcessor';
import { VisionAnalyzer } from './agents/VisionAnalyzer';
import { ValidatorAgent } from './agents/ValidatorAgent';
import { KycAgent } from './agents/KycAgent';
import { VectorMemory } from './memory/VectorMemory';


export class MultiAgentOrchestrator {
  private agents: Map<string, BaseAgent> = new Map();
  private memory: VectorMemory;


  constructor() {
    this.memory = new VectorMemory();
    this.registerAgents();
  }


  private registerAgents() {
    this.agents.set('Planner', new PlannerAgent());
    this.agents.set('VoiceProcessor', new VoiceProcessor());
    this.agents.set('VisionAnalyzer', new VisionAnalyzer());
    this.agents.set('InventoryExecutor', new InventoryExecutor());
    this.agents.set('Validator', new ValidatorAgent());
    this.agents.set('KycProcessor', new KycAgent());
  }


  /** Main Entry Point - Used by Voice, Vision, and API layers */
  async execute(userInput: string, context: Partial<AgentContext> = {}): Promise<AgentOutput> {
    const fullContext: AgentContext = {
      tenantId: context.tenantId || 'default',
      userId: context.userId || 'anonymous',
      memory: await this.memory.getRecent(context.tenantId),
      previousActions: context.previousActions || [],
      ...context
    };


    try {
      // Step 1: Planning
      const planner = this.agents.get('Planner')!;
      const planResult = await planner.execute(userInput, fullContext);


      if (!planResult.success) {
        return { success: false, error: 'Planning failed', confidence: 0.4 };
      }


      const plan = planResult.data;
      const executionResults: AgentOutput[] = [];


      // Step 2: Execute DAG sequentially with early stopping
      for (const step of plan.steps) {
        const agent = this.agents.get(step.agent);
        if (!agent) {
          console.warn(`Agent ${step.agent} not found`);
          continue;
        }


        const result = await agent.execute({ ...step, input: userInput }, fullContext);
        executionResults.push(result);


        // Critical failure handling
        if (!result.success && result.confidence < 0.65) {
          return {
            success: false,
            error: `Critical failure in ${step.agent}`,
            confidence: result.confidence,
            data: executionResults
          };
        }


        // Update memory
        await this.memory.store({
          tenantId: fullContext.tenantId,
          action: step.agent,
          result: result.data,
          timestamp: Date.now()
        });
      }


      // Step 3: Final Validation
      const validator = this.agents.get('Validator')!;
      const validation = await validator.execute(executionResults, fullContext);


      const finalResult: AgentOutput = {
        success: validation.success,
        data: {
          plan,
          results: executionResults,
          finalValidation: validation.data
        },
        confidence: Math.min(...executionResults.map(r => r.confidence)),
      };


      return finalResult;


    } catch (error) {
      console.error('Orchestrator Error:', error);
      return {
        success: false,
        error: error instanceof Error ? error.message : 'Unknown orchestrator error',
        confidence: 0.3
      };
    }
  }


  /** Get memory for debugging / UI */
  async getMemory(tenantId: string) {
    return this.memory.getRecent(tenantId);
  }
}


// Singleton Instance (Recommended usage)
export const orchestrator = new MultiAgentOrchestrator();

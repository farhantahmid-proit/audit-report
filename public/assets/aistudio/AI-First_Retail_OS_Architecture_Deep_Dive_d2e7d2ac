import sys
import json


# This mapping is based on the "Virtual Doctor" clinical context
# and the requirement to map Banglish queries like "matha betha".
CLINICAL_SYMPTOM_MAP = {
    "jor": "fever",
    "matha betha": "headache",
    "pet betha": "stomach pain",
    "kasi": "cough",
    "durbol": "weakness",
    "ombol": "acidity/reflux",
    "sas kosto": "shortness of breath",
    "buk betha": "chest pain"
}


def transliterate_banglish(text):
    """
    Processes Romanized Bangla (Banglish) and extracts structured medical intent.
    This acts as a "black box" utility for the agent.
    """
    input_normalized = text.lower()


    # 1. Map localized medical symptoms to English keywords
    detected_symptoms = []
    for banglish, english in CLINICAL_SYMPTOM_MAP.items():
        if banglish in input_normalized:
            detected_symptoms.append(english)


    # 2. Basic Phonetic Normalization (e.g., 'amar' to 'my')
    replacements = {
        "amar": "my",
        "korche": "experiencing",
        "hoche": "happening",
        "khub": "severe",
        "ache": "has/have"
    }


    transliterated_intent = input_normalized
    for b, e in replacements.items():
        transliterated_intent = transliterated_intent.replace(b, e)


    return {
        "original": text,
        "translated_intent": transliterated_intent.strip(),
        "clinical_waypoints": detected_symptoms # Extracted for Semantic Memory
    }


if __name__ == "__main__":
    # Accepting input from the "Multimodal Bridge" or Chatbot UI
    raw_query = sys.stdin.read().strip()


    if raw_query:
        result = transliterate_banglish(raw_query)
        # Structured output for the Memory-Inference Bridge
        print(json.dumps(result))



**`packages/database/conflictResolver.ts`**


```ts
import { database } from './index';
import { Q } from '@nozbe/watermelondb';


export class ConflictResolver {
  static async resolveInventoryConflicts(tenantId: string) {
    const localChanges = await database.collections
      .get('inventory_changes')
      .query(Q.where('tenant_id', tenantId), Q.where('synced', false))
      .fetch();


    for (const change of localChanges) {
      try {
        const serverState = await api.get(`/inventory/${change.product_id}`, {
          params: { tenantId }
        });


        const localTime = change.created_at;
        const serverTime = serverState.data.last_updated;


        if (localTime > serverTime) {
          // Local wins - push to server
          await api.post('/inventory/update', change);
        } else {
          // Server wins - update local
          await change.update(record => {
            record.delta = serverState.data.stock_delta;
            record.synced = true;
          });
        }
      } catch (error) {
        // Network issue - keep in queue
        console.log(`Conflict deferred for product ${change.product_id}`);
      }
    }
  }


  static async resolveAll(tenantId: string) {
    await Promise.all([
      this.resolveInventoryConflicts(tenantId),
      this.resolveSalesConflicts(tenantId)
    ]);
  }
}
```


